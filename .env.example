# GEMINI_API_KEY: Server-side Gemini capability required by platform
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g., Cloud Run service URL).
APP_URL="http://localhost:3000"

# GROQ CLOUD API: Used exclusively for YouTube metadata generation
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# GOOGLE OAUTH 2.0: For Google Drive and YouTube Data API access
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# SUPABASE POSTGRESQL & STORAGE CREDENTIALS (Required for production Supabase cloud persistence)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_BUCKET_MEDIA="user-content"
SUPABASE_STORAGE_BUCKET_THUMBNAILS="thumbnails"

# SOCIAL PLATFORM OAUTH CLIENTS (Configured by admin or environment)
# YouTube & Google Drive:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Instagram Graph API:
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# Facebook Graph API:
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# X (Twitter) API v2:
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# TikTok Content Posting API:
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# LinkedIn API:
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"
